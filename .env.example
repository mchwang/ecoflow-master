# Copy to .env and fill in from https://developer.ecoflow.com (Developer > Access key)
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
# Optional: Smart Home Panel 2 serial (starts with HD31). Leave blank to auto-detect.
ECOFLOW_SN=
# Americas accounts sometimes need https://api-a.ecoflow.com
ECOFLOW_HOST=https://api.ecoflow.com
