# Copy to .env and fill in from https://developer.ecoflow.com (Developer > Access key)
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
# Optional: Smart Home Panel 2 serial (starts with HD31). Leave blank to auto-detect.
ECOFLOW_SN=
# Region of your EcoFlow developer account: api-a (Americas, default) or api-e (Europe).
# Avoid the global api.ecoflow.com: it routes by the server's location, so a VPS abroad hits the wrong region.
ECOFLOW_HOST=https://api-a.ecoflow.com
# Control lease (only needed on copies other than the VPS): see README "Running more than one copy"
INSTANCE_NAME=
LEADER_URL=
LEADER_PASSWORD=
